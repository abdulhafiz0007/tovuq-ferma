# Admin kirish maʼlumotlari (productionda albatta oʻzgartiring)
ADMIN_USER=admin
ADMIN_PASS=admin123
# Tasodifiy uzun matn (sessiya imzosi uchun)
SESSION_SECRET=
# Upstash Redis (Vercel uchun majburiy, Render uchun tavsiya etiladi)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis ishlatilmasa, fayl yoʻli (Render Disk: /var/data/params.json)
DATA_FILE=
PORT=3000
